[Unit]
Description=Django Redefine Blog
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/django-redefine-blog
EnvironmentFile=/etc/django-redefine-blog.env
RuntimeDirectory=django-redefine-blog
RuntimeDirectoryMode=0755
ExecStart=/srv/django-redefine-blog/venv/bin/gunicorn config.wsgi:application --workers 2 --threads 2 --timeout 60 --bind unix:/run/django-redefine-blog/gunicorn.sock
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

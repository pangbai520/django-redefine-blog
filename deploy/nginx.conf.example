upstream django_redefine_blog {
    server unix:/run/django-redefine-blog/gunicorn.sock fail_timeout=0;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com www.example.com;
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    client_max_body_size 5m;

    location /static/ {
        alias /srv/django-redefine-blog/static/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location /resources/ {
        alias /srv/django-redefine-blog/media/;
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        proxy_pass http://django_redefine_blog;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 65s;
    }
}

# This file documents the runtime environment. Django does not load .env files
# by itself; export these values through your shell, process manager or container.

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
TRUST_X_FORWARDED_FOR=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_TRUST_PROXY_PROTO=1

# SQLite is the local default. PostgreSQL is recommended for production;
# MySQL is also supported with DB_ENGINE=mysql and DB_PORT=3306.
DB_ENGINE=postgresql
DB_NAME=django_blog
DB_USER=django_blog
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

STATIC_ROOT=/srv/django-redefine-blog/static
MEDIA_ROOT=/srv/django-redefine-blog/media
DJANGO_LOG_DIR=/var/log/django-redefine-blog
DJANGO_LOG_LEVEL=INFO

# The console backend is convenient for local work. Replace it in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=blog@example.com
EMAIL_HOST_PASSWORD=replace-with-your-mail-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="Blog <blog@example.com>"

# For implicit SSL on port 465, use blog.email_backend.SMTPSSLBackend and set
# EMAIL_USE_SSL=1, EMAIL_USE_TLS=0.

# Enable these only after every subdomain is HTTPS-only.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
